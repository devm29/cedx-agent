# Settings read from the environment by tinycedx/config.py. Nothing loads this file into the
# pipeline itself: export the values you need, or copy it to .env, which Docker Compose reads
# for ${CASE_ID} and ${PIPELINE_NOW}.

# Offline replay of committed transcripts (default). false = call a real model.
REPLAY_LLM=true
CASE_ID=CEDX-82C0A1
# "Today" for the STALE check.
PIPELINE_NOW=2026-06-26
# SEED_DIR=seed
# OUT_DIR=out
# TRANSCRIPTS_DIR=transcripts

# Per-record ceilings enforced by the orchestrator.
MAX_COST_USD_PER_RECORD=0.02
MAX_STEPS_PER_RECORD=4

# Live path only (REPLAY_LLM=false). Supported families: gpt-*, claude-*, gemini-*.
LLM_API_KEY=
# Model for the cheap tier, and for the strong tier unless LLM_MODEL_STRONG is set.
# Leave both empty to use gpt-4o-mini / gpt-4o.
LLM_MODEL=
LLM_MODEL_STRONG=
# Optional override for an OpenAI-compatible or proxy endpoint.
LLM_BASE_URL=
